---
import { SITE } from '../data/site';

export interface Props {
  preselectService?: string;
  id?: string;
  heading?: string;
}

const {
  preselectService,
  id = 'quote-form',
  heading = 'Request Your Free Quote',
} = Astro.props;

const serviceOptions = [
  'Driveway Cleaning',
  'Patio Cleaning',
  'Roof Cleaning',
  'Soft Washing',
  'Render Cleaning',
  'Decking Restoration',
  'Commercial Power Washing',
  'Farmyard & Agri Cleaning',
  'Gutter Cleaning',
  'Other',
];
---

<div id={id} class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="text-lg font-semibold text-slate-900 mb-4">{heading}</h2>

  <div class="form-success hidden rounded-md bg-green-50 border border-green-200 p-4 text-sm text-green-800">
    <strong>Thanks — we'll be in touch within 24 hours.</strong>
  </div>
  <div class="form-error hidden rounded-md bg-red-50 border border-red-200 p-4 text-sm text-red-800">
    Sorry, something went wrong. Please call
    <a href={`tel:${SITE.phoneTel}`} class="font-semibold underline">{SITE.phone}</a>.
  </div>

  <form class="lead-form space-y-3 mt-1" novalidate>
    <div>
      <label class="block text-xs font-medium text-slate-700 mb-1">
        Name <span aria-hidden="true">*</span>
      </label>
      <input name="name" type="text" required autocomplete="name" placeholder="Your name" class="form-input" />
    </div>

    <div>
      <label class="block text-xs font-medium text-slate-700 mb-1">
        Phone <span aria-hidden="true">*</span>
      </label>
      <input name="phone" type="tel" required autocomplete="tel" placeholder="087 000 0000" class="form-input" />
    </div>

    <div>
      <label class="block text-xs font-medium text-slate-700 mb-1">
        Email <span aria-hidden="true">*</span>
      </label>
      <input name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="form-input" />
    </div>

    <div>
      <label class="block text-xs font-medium text-slate-700 mb-1">
        Service <span aria-hidden="true">*</span>
      </label>
      <select name="service" required class="form-input">
        <option value="">Select a service…</option>
        {serviceOptions.map((o) => (
          <option value={o} selected={preselectService === o}>{o}</option>
        ))}
      </select>
    </div>

    <div>
      <label class="block text-xs font-medium text-slate-700 mb-1">
        Town / Area in Kilkenny <span aria-hidden="true">*</span>
      </label>
      <input name="town" type="text" required placeholder="e.g. Kilkenny City, Callan, Thomastown" class="form-input" />
    </div>

    <div>
      <label class="block text-xs font-medium text-slate-700 mb-1">Notes (optional)</label>
      <textarea name="notes" rows="3" placeholder="Anything else we should know?" class="form-input"></textarea>
    </div>

    <label class="flex items-start gap-2 text-xs text-slate-600">
      <input name="consent" type="checkbox" class="mt-0.5" />
      <span>
        I consent to my details being passed to a local contractor to provide a quote.
        See our <a href="/privacy" class="underline">Privacy Policy</a>.
      </span>
    </label>
    <p class="consent-error hidden text-xs text-red-600">
      Please tick the consent box to continue.
    </p>

    <button type="submit" class="btn-accent w-full">Request My Free Quote</button>
  </form>
</div>

<script>
  document.querySelectorAll<HTMLFormElement>('form.lead-form').forEach((form) => {
    const root = form.closest('[id]') as HTMLElement | null;
    const successEl = root?.querySelector('.form-success') as HTMLElement | null;
    const errorEl = root?.querySelector('.form-error') as HTMLElement | null;
    const consentError = root?.querySelector('.consent-error') as HTMLElement | null;
    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl?.classList.add('hidden');
      consentError?.classList.add('hidden');

      const consent = (form.elements.namedItem('consent') as HTMLInputElement)?.checked;
      if (!consent) {
        consentError?.classList.remove('hidden');
        return;
      }

      if (submitBtn) {
        submitBtn.textContent = 'Sending…';
        submitBtn.disabled = true;
      }

      const fd = new FormData(form);
      const payload: Record<string, string> = {};
      for (const [k, v] of fd.entries()) {
        if (k !== 'consent') payload[k] = v as string;
      }
      if (!payload.notes) delete payload.notes;

      try {
        const res = await fetch('/.netlify/functions/submit-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        form.hidden = true;
        successEl?.classList.remove('hidden');
      } catch {
        errorEl?.classList.remove('hidden');
        if (submitBtn) {
          submitBtn.textContent = 'Request My Free Quote';
          submitBtn.disabled = false;
        }
      }
    });
  });
</script>
