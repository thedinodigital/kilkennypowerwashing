---
import { SITE } from '../data/site';
import { SERVICES } from '../data/services';

const phoneSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.77h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.77-.77a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.5 17z"/></svg>`;

const waSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>`;
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">

    <a href="/" class="font-semibold text-primary">
      <span class="hidden sm:inline">Kilkenny Power Washing</span>
      <span class="sm:hidden">Kilkenny PW</span>
    </a>

    <nav class="hidden items-center gap-5 md:flex" aria-label="Main navigation">
      <a href="/" class="text-sm text-slate-600 transition-colors hover:text-primary">Home</a>

      <div class="relative group">
        <button
          type="button"
          class="inline-flex items-center gap-1 text-sm text-slate-600 transition-colors hover:text-primary"
          aria-haspopup="true"
          aria-expanded="false"
        >
          Services
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div
          class="invisible absolute left-1/2 top-full z-50 mt-2 w-72 -translate-x-1/2 rounded-lg border border-slate-200 bg-white p-2 opacity-0 shadow-lg transition-all group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
        >
          <ul class="grid gap-1 text-sm">
            {SERVICES.map((s) => (
              <li>
                <a
                  href={s.slug}
                  class="block rounded-md px-3 py-2 text-slate-700 hover:bg-slate-50 hover:text-primary"
                >
                  <div class="font-medium">{s.name}</div>
                  {s.priceFrom && (
                    <div class="text-xs text-slate-500">from {s.priceFrom}</div>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <a href="/#areas" class="text-sm text-slate-600 transition-colors hover:text-primary">Areas</a>
      <a href="/#about" class="text-sm text-slate-600 transition-colors hover:text-primary">About</a>
      <a href="/#quote-form" class="text-sm text-slate-600 transition-colors hover:text-primary">Contact</a>

      <a
        href={`tel:${SITE.phoneTel}`}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-primary"
      >
        <Fragment set:html={phoneSvg.replace('width="20" height="20"', 'width="14" height="14"')} />
        {SITE.phone}
      </a>
      <a
        href={SITE.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="WhatsApp us"
        class="flex h-9 w-9 items-center justify-center rounded-full text-white transition-opacity hover:opacity-90"
        style="background-color: #25D366;"
      >
        <Fragment set:html={waSvg.replace('width="20" height="20"', 'width="18" height="18"')} />
      </a>
      <a href="/#quote-form" class="btn-accent text-xs px-4 py-2">Get a Quote</a>
    </nav>

    <div class="flex items-center gap-1 md:hidden">
      <a
        href={SITE.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="WhatsApp us"
        class="flex h-10 w-10 items-center justify-center rounded-full text-white"
        style="background-color: #25D366;"
      >
        <Fragment set:html={waSvg} />
      </a>

      <a
        href={`tel:${SITE.phoneTel}`}
        aria-label={`Call ${SITE.phone}`}
        class="flex h-10 w-10 items-center justify-center rounded-full bg-accent text-white"
      >
        <Fragment set:html={phoneSvg} />
      </a>

      <button
        id="mobile-menu-btn"
        class="flex h-10 w-10 items-center justify-center rounded-md text-slate-600 hover:text-primary"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white md:hidden">
    <nav class="mx-auto max-w-6xl px-4 py-3 flex flex-col gap-1" aria-label="Mobile navigation">
      <a href="/" class="mobile-nav-link rounded-md px-2 py-3 text-base text-slate-700 hover:text-primary">Home</a>

      <details class="group">
        <summary class="flex cursor-pointer items-center justify-between rounded-md px-2 py-3 text-base text-slate-700 hover:text-primary">
          <span>Services</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="pl-3 pb-2">
          {SERVICES.map((s) => (
            <a href={s.slug} class="mobile-nav-link block rounded-md px-2 py-2 text-sm text-slate-600 hover:text-primary">
              {s.name}
            </a>
          ))}
        </div>
      </details>

      <a href="/#areas" class="mobile-nav-link rounded-md px-2 py-3 text-base text-slate-700 hover:text-primary">Areas</a>
      <a href="/#about" class="mobile-nav-link rounded-md px-2 py-3 text-base text-slate-700 hover:text-primary">About</a>
      <a href="/#quote-form" class="mobile-nav-link rounded-md px-2 py-3 text-base text-slate-700 hover:text-primary">Contact</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  if (btn && menu && iconMenu && iconClose) {
    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isOpen));
      iconMenu.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });
</script>
