<!-- Cookie consent banner — bottom strip, above mobile CTA -->
<div
  id="cookie-banner"
  role="dialog"
  aria-label="Cookie consent"
  aria-live="polite"
  class="fixed inset-x-0 bottom-36 z-50 mx-auto max-w-2xl px-4 md:bottom-4"
  hidden
>
  <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-lg">
    <p class="text-sm text-slate-700">
      We use cookies to make this site work. With your consent, we may also use analytics and
      marketing cookies. You can accept all, reject all, or customise. See our
      <a href="/cookies" class="text-primary underline">Cookie Policy</a>.
    </p>

    <!-- Customise panel (hidden by default) -->
    <div id="cookie-custom-panel" class="mt-4 hidden space-y-3 text-sm">
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="font-medium text-slate-900">Essential</div>
          <div class="text-xs text-slate-500">Required for the site to function. Always on.</div>
        </div>
        <span class="text-xs text-slate-400 mt-1">Always on</span>
      </div>
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="font-medium text-slate-900">Analytics</div>
          <div class="text-xs text-slate-500">Anonymous usage stats so we can improve the site.</div>
        </div>
        <label class="relative inline-flex cursor-pointer items-center">
          <input id="toggle-analytics" type="checkbox" class="sr-only peer" />
          <div class="h-5 w-9 rounded-full bg-slate-200 peer-checked:bg-primary peer-focus:ring-2 peer-focus:ring-primary/30 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:shadow after:transition-all peer-checked:after:translate-x-4"></div>
        </label>
      </div>
      <div class="flex items-start justify-between gap-4">
        <div>
          <div class="font-medium text-slate-900">Marketing</div>
          <div class="text-xs text-slate-500">Used to measure ad campaigns. Off by default.</div>
        </div>
        <label class="relative inline-flex cursor-pointer items-center">
          <input id="toggle-marketing" type="checkbox" class="sr-only peer" />
          <div class="h-5 w-9 rounded-full bg-slate-200 peer-checked:bg-primary peer-focus:ring-2 peer-focus:ring-primary/30 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-4 after:w-4 after:rounded-full after:bg-white after:shadow after:transition-all peer-checked:after:translate-x-4"></div>
        </label>
      </div>
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-end gap-2">
      <button
        id="cookie-customise-btn"
        class="rounded-md px-3 py-1.5 text-sm text-slate-600 hover:bg-slate-100 transition-colors"
      >
        Customise
      </button>
      <button
        id="cookie-reject-btn"
        class="rounded-md border border-slate-300 px-3 py-1.5 text-sm text-slate-700 hover:bg-slate-50 transition-colors"
      >
        Reject All
      </button>
      <button
        id="cookie-accept-btn"
        class="rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-white hover:bg-primary-dark transition-colors"
      >
        Accept All
      </button>
    </div>
  </div>
</div>

<script>
  const KEY = 'kpw-cookie-consent-v1';
  const banner = document.getElementById('cookie-banner')!;
  const customPanel = document.getElementById('cookie-custom-panel')!;
  const customiseBtn = document.getElementById('cookie-customise-btn')!;
  const rejectBtn = document.getElementById('cookie-reject-btn')!;
  const acceptBtn = document.getElementById('cookie-accept-btn')!;
  const toggleAnalytics = document.getElementById('toggle-analytics') as HTMLInputElement;
  const toggleMarketing = document.getElementById('toggle-marketing') as HTMLInputElement;

  let inCustomMode = false;

  function hasConsent(): boolean {
    try {
      return !!localStorage.getItem(KEY);
    } catch {
      return false;
    }
  }

  function saveConsent(analytics: boolean, marketing: boolean) {
    try {
      localStorage.setItem(
        KEY,
        JSON.stringify({ essential: true, analytics, marketing, ts: Date.now() })
      );
    } catch {
      // ignore
    }
  }

  function dismiss(analytics: boolean, marketing: boolean) {
    saveConsent(analytics, marketing);
    banner.hidden = true;
  }

  if (!hasConsent()) {
    banner.hidden = false;
  }

  customiseBtn.addEventListener('click', () => {
    inCustomMode = true;
    customPanel.classList.remove('hidden');
    customiseBtn.classList.add('hidden');
    acceptBtn.textContent = 'Save Choices';
  });

  rejectBtn.addEventListener('click', () => dismiss(false, false));

  acceptBtn.addEventListener('click', () => {
    if (inCustomMode) {
      dismiss(toggleAnalytics.checked, toggleMarketing.checked);
    } else {
      dismiss(true, true);
    }
  });
</script>
