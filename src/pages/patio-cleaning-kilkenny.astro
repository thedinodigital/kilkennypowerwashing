---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE } from '../data/site';

const title = "Patio Cleaning Kilkenny | Moss & Algae Removal | From €100";
const description = "Patio power washing in Kilkenny from €100. Sandstone, concrete, slab and natural stone patios cleaned and re-sanded. Free quote within 24 hours.";
const canonical = "https://kilkennypowerwashing.ie/patio-cleaning-kilkenny";

const serviceSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Patio Cleaning",
    "serviceType": "Patio Cleaning",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Kilkenny Power Washing",
      "url": "https://kilkennypowerwashing.ie",
      "telephone": "+353874041811",
      "areaServed": "County Kilkenny, Ireland"
    },
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "County Kilkenny, Ireland"
    },
    "description": "Patio power washing in Kilkenny from €100. Sandstone, concrete, slab and natural stone patios cleaned and re-sanded. Free quote within 24 hours.",
    "url": "https://kilkennypowerwashing.ie/patio-cleaning-kilkenny",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "price": "100",
      "url": "https://kilkennypowerwashing.ie/patio-cleaning-kilkenny"
    }
  };

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Will the moss come back straight away?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Not straight away — the biocide we use kills back the spore base in the surface, so re-growth is slow. Most customers get 12 months before the patio starts to green up again."
        }
      },
      {
        "@type": "Question",
        "name": "Can you clean a sandstone patio without damaging it?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Sandstone needs a softer approach than concrete — we use lower pressure and let the chemical pre-treatment do most of the work. Aggressive blasting on sandstone pits the surface; we don&rsquo;t do that."
        }
      },
      {
        "@type": "Question",
        "name": "Do you re-sand the joints?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, where the patio is jointed with sand. Kiln-dried sand is included as standard. Patios pointed with mortar don&rsquo;t need this."
        }
      },
      {
        "@type": "Question",
        "name": "Can you clean around plants and pots?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, we move pots and furniture aside, work carefully around planting, and rinse off any biocide that drifts onto leaves. Tell us about any sensitive planting before we start."
        }
      },
      {
        "@type": "Question",
        "name": "Do you take payment after the job?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We don&rsquo;t take a deposit and you only pay when you&rsquo;re happy with the result. Bank transfer, card or cash all fine."
        }
      }
    ]
  };
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={[serviceSchema, faqSchema]}
>
  <Header />

  <main>
    <!-- ===== HERO ===== -->
    <section class="bg-gradient-to-b from-primary/5 to-white">
      <div class="mx-auto max-w-6xl px-4 py-12 md:py-16 grid gap-10 lg:grid-cols-2 lg:items-start">
        <div>
          <nav class="text-xs text-slate-500 mb-3" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary">Home</a>
            <span class="mx-1">/</span>
            <span class="text-slate-700">Patio Cleaning</span>
          </nav>

          <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 leading-tight">
            Patio Cleaning in Kilkenny
          </h1>
          <p class="mt-4 text-lg text-slate-600">
            A patio is meant to be where you sit out for a coffee in the sun or have friends over on a summer evening. After a couple of damp Irish winters, it can end up green, slippery and miserable instead.
          </p>
          <p class="mt-4 text-lg text-slate-600">
            We strip years of moss, algae, lichen and ground-in grime off patios across County Kilkenny and leave the surface clean, dry and safe to walk on. Most patio cleans take a half-day, prices start at €100, and quotes come back within 24 hours.
          </p>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="#quote-form" class="btn-accent">Get a Free Quote</a>
            <a href={`tel:${SITE.phoneTel}`} class="btn-outline">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.77h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.77-.77a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.5 17z"/></svg>
              Call {SITE.phone}
            </a>
            <a
              href={SITE.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:opacity-90"
              style="background-color: #25D366;"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              WhatsApp
            </a>
          </div>

          <ul class="mt-6 text-sm text-slate-600 space-y-1.5">
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Fully insured local team</span></li>
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Free no-obligation quotes</span></li>
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Serving all of County Kilkenny</span></li>
          </ul>
        </div>

        <div class="lg:pl-4">
          <QuoteForm preselectService="Patio Cleaning" />
        </div>
      </div>
    </section>

    <!-- ===== WHAT'S INCLUDED + SURFACES ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">What's included</h2>
          <ul class="mt-6 space-y-2 text-slate-700">
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Biocide pre-treatment to kill back algae, lichen and moss at the root</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Hot-water wash with a flat surface cleaner — even, streak-free finish</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Weeds and growth removed from joints</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Kiln-dried sand re-applied to any jointed slab work</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Garden furniture moved aside and put back where needed</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Final rinse and tidy — patio left ready to use</span></li>
          </ul>
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Surfaces we clean</h2>
          <ul class="mt-6 space-y-2 text-slate-700">
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Sandstone (Indian, Yorkstone) — soft-washed where high pressure isn&rsquo;t suitable</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Limestone and granite slabs</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Concrete and concrete-pattern paving</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Porcelain patio tiles (low-pressure, no etching)</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Block paving patios</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Old cobbled or natural stone patios</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== PRICING ===== -->
    <section class="bg-slate-50 py-12 md:py-16 border-y border-slate-200">
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Patio Cleaning prices in Kilkenny</h2>
        <p class="mt-3 text-slate-600 leading-relaxed max-w-3xl">Final quotes depend on size, surface and how badly weathered the patio is. Typical ranges in Kilkenny:</p>
        <ul class="mt-6 grid gap-2 text-slate-700 max-w-3xl">
          <li class="flex gap-2"><span class="text-accent">€</span><span>Small patio (up to 15m²): €100–€140</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Medium patio (15–35m²): €140–€200</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Larger patio (35–60m²): €200–€250</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Big garden patio (60m²+): quoted on site</span></li>
        </ul>
        <p class="mt-4 text-sm text-slate-500 max-w-3xl">
          Final quote depends on site, condition and access. Free, no-obligation quote within 24 hours.
        </p>
      </div>
    </section>

    <!-- ===== PROCESS / DETAILS ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2">
      <div>
        <h3 class="text-xl font-semibold text-slate-900">Will pressure washing damage my patio?</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">Not with the right technique. Sandstone and porcelain need a softer touch than concrete — we adjust pressure, nozzle and method to the surface. For delicate stone we use a low-pressure soft-wash method with a biocide; the chemical does the work, not the pressure.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">How long does it take?</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">Most domestic patios in Kilkenny take 2 to 4 hours. Heavily soiled patios with deep moss in the joints take longer — the biocide needs time to dwell before we wash off.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">How often should you clean a patio?</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">Every 12 months in Ireland is the sweet spot. Patios in shaded gardens — under trees or against a north-facing wall — typically need cleaning every spring. Sunny, open patios can stretch to every 18–24 months.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">Areas we cover</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">All of County Kilkenny — Kilkenny City, Loughboy, Ferrybank, Callan, Thomastown, Castlecomer, Graiguenamanagh, Bennettsbridge, Freshford, Gowran, Mooncoin, Piltown, Inistioge, Urlingford and surrounding areas.</p>
      </div>
      </div>
    </section>

    <!-- ===== FAQs ===== -->
    <section class="bg-slate-50 py-12 md:py-16 border-y border-slate-200">
      <div class="mx-auto max-w-3xl px-4">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Frequently asked questions</h2>
        <div class="mt-6 space-y-3">
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Will the moss come back straight away?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Not straight away — the biocide we use kills back the spore base in the surface, so re-growth is slow. Most customers get 12 months before the patio starts to green up again.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Can you clean a sandstone patio without damaging it?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes. Sandstone needs a softer approach than concrete — we use lower pressure and let the chemical pre-treatment do most of the work. Aggressive blasting on sandstone pits the surface; we don&rsquo;t do that.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Do you re-sand the joints?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes, where the patio is jointed with sand. Kiln-dried sand is included as standard. Patios pointed with mortar don&rsquo;t need this.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Can you clean around plants and pots?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes, we move pots and furniture aside, work carefully around planting, and rinse off any biocide that drifts onto leaves. Tell us about any sensitive planting before we start.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Do you take payment after the job?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes. We don&rsquo;t take a deposit and you only pay when you&rsquo;re happy with the result. Bank transfer, card or cash all fine.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- ===== CTA + RELATED ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2 md:items-start">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Ready for a clean finish?</h2>
          <p class="mt-3 text-slate-600 leading-relaxed">
            Get a free, no-obligation quote — usually within 24 hours.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="#quote-form" class="btn-accent">Request a Quote</a>
            <a href={`tel:${SITE.phoneTel}`} class="btn-outline">{SITE.phone}</a>
          </div>
        </div>

        <div>
          <h3 class="text-lg font-semibold text-slate-900">Other services we offer</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/driveway-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Driveway Cleaning</a></li>
            <li><a href="/decking-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Decking Restoration</a></li>
            <li><a href="/soft-washing-kilkenny" class="text-primary hover:text-primary-dark">Soft Washing</a></li>
            <li><a href="/render-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Render Cleaning</a></li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
