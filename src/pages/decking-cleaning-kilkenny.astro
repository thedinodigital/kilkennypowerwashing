---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE } from '../data/site';

const title = "Decking Cleaning Kilkenny | Strip & Restore | From €150";
const description = "Decking cleaning and restoration in Kilkenny. Strip back the grey, kill mould and bring out the timber. Re-oiling available. Free quote within 24 hours.";
const canonical = "https://kilkennypowerwashing.ie/decking-cleaning-kilkenny";

const serviceSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Decking Restoration",
    "serviceType": "Decking Restoration",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Kilkenny Power Washing",
      "url": "https://kilkennypowerwashing.ie",
      "telephone": "+353874041811",
      "areaServed": "County Kilkenny, Ireland"
    },
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "County Kilkenny, Ireland"
    },
    "description": "Decking cleaning and restoration in Kilkenny. Strip back the grey, kill mould and bring out the timber. Re-oiling available. Free quote within 24 hours.",
    "url": "https://kilkennypowerwashing.ie/decking-cleaning-kilkenny",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "price": "150",
      "url": "https://kilkennypowerwashing.ie/decking-cleaning-kilkenny"
    }
  };

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can a really grey old deck actually be brought back?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In most cases, yes. If the boards are structurally sound — not rotten, not cracked through — restoring the surface is far cheaper than replacing the deck. We&rsquo;ll do a small test patch and show you the result before quoting the full job."
        }
      },
      {
        "@type": "Question",
        "name": "What kind of oil or stain do you use?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We use professional decking oils that soak into the timber rather than sit on the surface (the surface films are the ones that flake off after a year). We can match a colour or go with a clear finish to keep the natural look."
        }
      },
      {
        "@type": "Question",
        "name": "Will the chemicals harm the plants around the deck?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No — we protect planting before we start, rinse any drift immediately, and use chemicals at the correct working concentration."
        }
      },
      {
        "@type": "Question",
        "name": "Do you clean composite decking?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes — composite decks need a much gentler approach. We use a low-pressure rinse and a specific composite-safe cleaner. No turbo nozzles."
        }
      },
      {
        "@type": "Question",
        "name": "Can the deck still be walked on while it dries?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Leave it 24 hours before walking on it after cleaning, and 48 hours after an oil application for a proper cure."
        }
      }
    ]
  };
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={[serviceSchema, faqSchema]}
>
  <Header />

  <main>
    <!-- ===== HERO ===== -->
    <section class="bg-gradient-to-b from-primary/5 to-white">
      <div class="mx-auto max-w-6xl px-4 py-12 md:py-16 grid gap-10 lg:grid-cols-2 lg:items-start">
        <div>
          <nav class="text-xs text-slate-500 mb-3" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary">Home</a>
            <span class="mx-1">/</span>
            <span class="text-slate-700">Decking Restoration</span>
          </nav>

          <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 leading-tight">
            Decking Cleaning & Restoration in Kilkenny
          </h1>
          <p class="mt-4 text-lg text-slate-600">
            An old timber deck doesn&rsquo;t have to be ripped up and replaced. Under the grey, slippery, moss-covered surface is usually perfectly good wood.
          </p>
          <p class="mt-4 text-lg text-slate-600">
            We strip back years of weathering, kill mould and algae, and bring out the natural colour of the timber. Add a re-oil or stain on top and a tired deck looks new again. Decking restoration in Kilkenny starts at €150. Free quote within 24 hours.
          </p>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="#quote-form" class="btn-accent">Get a Free Quote</a>
            <a href={`tel:${SITE.phoneTel}`} class="btn-outline">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.77h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.77-.77a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.5 17z"/></svg>
              Call {SITE.phone}
            </a>
            <a
              href={SITE.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:opacity-90"
              style="background-color: #25D366;"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              WhatsApp
            </a>
          </div>

          <ul class="mt-6 text-sm text-slate-600 space-y-1.5">
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Fully insured local team</span></li>
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Free no-obligation quotes</span></li>
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Serving all of County Kilkenny</span></li>
          </ul>
        </div>

        <div class="lg:pl-4">
          <QuoteForm preselectService="Decking Restoration" />
        </div>
      </div>
    </section>

    <!-- ===== WHAT'S INCLUDED + SURFACES ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">What's included</h2>
          <ul class="mt-6 space-y-2 text-slate-700">
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Pre-treatment with a deck-safe biocide to kill mould, algae and lichen</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Gentle low-pressure clean along the grain — never across it</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Removal of weeds and debris between boards</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Drying time before any oil or stain is applied (24–48 hours)</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Optional decking oil or stain in a colour of your choice</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>All works carried out by an insured operator</span></li>
          </ul>
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Surfaces we clean</h2>
          <ul class="mt-6 space-y-2 text-slate-700">
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Softwood decking (treated pine / spruce — the most common in Ireland)</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Hardwood decking (Iroko, Balau, Cumaru)</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Composite decking (Trex, Millboard etc.) — gentle wash only</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Older mixed-material decking</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== PRICING ===== -->
    <section class="bg-slate-50 py-12 md:py-16 border-y border-slate-200">
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Decking Restoration prices in Kilkenny</h2>
        <p class="mt-3 text-slate-600 leading-relaxed max-w-3xl">Pricing depends on size, condition and whether you&rsquo;d like a re-oil afterwards:</p>
        <ul class="mt-6 grid gap-2 text-slate-700 max-w-3xl">
          <li class="flex gap-2"><span class="text-accent">€</span><span>Small deck (up to 10m²): €150–€220</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Medium deck (10–25m²): €220–€320</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Larger deck (25m²+): €320–€400+</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Re-oiling / staining: quoted separately by board count and product</span></li>
        </ul>
        <p class="mt-4 text-sm text-slate-500 max-w-3xl">
          Final quote depends on site, condition and access. Free, no-obligation quote within 24 hours.
        </p>
      </div>
    </section>

    <!-- ===== PROCESS / DETAILS ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2">
      <div>
        <h3 class="text-xl font-semibold text-slate-900">Why high pressure ruins a deck</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">Pressure-washing decking with a turbo nozzle blasts away the soft springwood between the grain lines, leaving a fluffy, splinter-prone surface. We never do this.</p>
        <p class="mt-3 text-slate-600 leading-relaxed">The right method is a soft-wash with a biocide pre-treatment followed by a gentle wash along the grain. The timber comes up looking like new without losing the surface.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">How long does it take?</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">A clean and a kill-treatment is usually done in half a day. If you&rsquo;re re-oiling or re-staining, we let the deck dry for 24–48 hours and come back to apply the finish — usually a second short visit.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">How long does the finish last?</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">A proper clean and re-oil typically gives 12–18 months before the deck needs a top-up. A light annual freshen-up is much cheaper than letting it go grey again.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">Areas we cover</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">All of County Kilkenny — Kilkenny City, Loughboy, Callan, Thomastown, Castlecomer, Graiguenamanagh, Bennettsbridge, Freshford, Gowran and surrounding villages.</p>
      </div>
      </div>
    </section>

    <!-- ===== FAQs ===== -->
    <section class="bg-slate-50 py-12 md:py-16 border-y border-slate-200">
      <div class="mx-auto max-w-3xl px-4">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Frequently asked questions</h2>
        <div class="mt-6 space-y-3">
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Can a really grey old deck actually be brought back?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">In most cases, yes. If the boards are structurally sound — not rotten, not cracked through — restoring the surface is far cheaper than replacing the deck. We&rsquo;ll do a small test patch and show you the result before quoting the full job.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>What kind of oil or stain do you use?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">We use professional decking oils that soak into the timber rather than sit on the surface (the surface films are the ones that flake off after a year). We can match a colour or go with a clear finish to keep the natural look.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Will the chemicals harm the plants around the deck?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">No — we protect planting before we start, rinse any drift immediately, and use chemicals at the correct working concentration.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Do you clean composite decking?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes — composite decks need a much gentler approach. We use a low-pressure rinse and a specific composite-safe cleaner. No turbo nozzles.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Can the deck still be walked on while it dries?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Leave it 24 hours before walking on it after cleaning, and 48 hours after an oil application for a proper cure.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- ===== CTA + RELATED ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2 md:items-start">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Ready for a clean finish?</h2>
          <p class="mt-3 text-slate-600 leading-relaxed">
            Get a free, no-obligation quote — usually within 24 hours.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="#quote-form" class="btn-accent">Request a Quote</a>
            <a href={`tel:${SITE.phoneTel}`} class="btn-outline">{SITE.phone}</a>
          </div>
        </div>

        <div>
          <h3 class="text-lg font-semibold text-slate-900">Other services we offer</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/patio-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Patio Cleaning</a></li>
            <li><a href="/soft-washing-kilkenny" class="text-primary hover:text-primary-dark">Soft Washing</a></li>
            <li><a href="/driveway-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Driveway Cleaning</a></li>
            <li><a href="/render-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Render Cleaning</a></li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
