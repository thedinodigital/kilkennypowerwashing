---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE } from '../data/site';

const title = "Commercial Power Washing Kilkenny | Shopfronts, Car Parks, Yards";
const description = "Commercial power washing in Kilkenny. Shopfronts, forecourts, car parks, warehouses. Out-of-hours scheduling available. Fully insured. Free quote within 24 hours.";
const canonical = "https://kilkennypowerwashing.ie/commercial-power-washing-kilkenny";

const serviceSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Commercial Power Washing",
    "serviceType": "Commercial Power Washing",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Kilkenny Power Washing",
      "url": "https://kilkennypowerwashing.ie",
      "telephone": "+353874041811",
      "areaServed": "County Kilkenny, Ireland"
    },
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "County Kilkenny, Ireland"
    },
    "description": "Commercial power washing in Kilkenny. Shopfronts, forecourts, car parks, warehouses. Out-of-hours scheduling available. Fully insured. Free quote within 24 hours.",
    "url": "https://kilkennypowerwashing.ie/commercial-power-washing-kilkenny"
  };

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Do you work outside business hours?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Most retail, hospitality and fuel-forecourt cleans are scheduled outside trading hours — evenings, early mornings or weekends — so we don&rsquo;t disrupt customers or staff."
        }
      },
      {
        "@type": "Question",
        "name": "Can you provide insurance documentation?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We can send a copy of our public liability cover before any work starts, and full RAMS for larger or higher-risk sites."
        }
      },
      {
        "@type": "Question",
        "name": "Do you remove chewing gum?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, specialist gum removal is available as an add-on to any pavement, shopfront or entrance clean."
        }
      },
      {
        "@type": "Question",
        "name": "Can we set up a regular monthly clean?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes — and you&rsquo;ll get a better rate than ad-hoc visits. We&rsquo;ll agree the scope, schedule and fixed price up front."
        }
      },
      {
        "@type": "Question",
        "name": "Do you VAT-invoice?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes — full VAT invoices are issued where required. Happy to be added to a supplier portal or PO system."
        }
      }
    ]
  };
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={[serviceSchema, faqSchema]}
>
  <Header />

  <main>
    <!-- ===== HERO ===== -->
    <section class="bg-gradient-to-b from-primary/5 to-white">
      <div class="mx-auto max-w-6xl px-4 py-12 md:py-16 grid gap-10 lg:grid-cols-2 lg:items-start">
        <div>
          <nav class="text-xs text-slate-500 mb-3" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary">Home</a>
            <span class="mx-1">/</span>
            <span class="text-slate-700">Commercial Power Washing</span>
          </nav>

          <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 leading-tight">
            Commercial Power Washing in Kilkenny
          </h1>
          <p class="mt-4 text-lg text-slate-600">
            First impressions count. A dirty shopfront, oil-stained car park or moss-covered forecourt costs you business before a customer ever walks in.
          </p>
          <p class="mt-4 text-lg text-slate-600">
            We provide professional, fully-insured commercial power washing across County Kilkenny for shops, offices, restaurants, hotels, schools, warehouses, fuel forecourts and retail parks. Out-of-hours scheduling available so we don&rsquo;t disrupt trading. Free quote within 24 hours.
          </p>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="#quote-form" class="btn-accent">Get a Free Quote</a>
            <a href={`tel:${SITE.phoneTel}`} class="btn-outline">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.77h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.77-.77a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.5 17z"/></svg>
              Call {SITE.phone}
            </a>
            <a
              href={SITE.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:opacity-90"
              style="background-color: #25D366;"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              WhatsApp
            </a>
          </div>

          <ul class="mt-6 text-sm text-slate-600 space-y-1.5">
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Fully insured local team</span></li>
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Free no-obligation quotes</span></li>
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Serving all of County Kilkenny</span></li>
          </ul>
        </div>

        <div class="lg:pl-4">
          <QuoteForm preselectService="Commercial Power Washing" />
        </div>
      </div>
    </section>

    <!-- ===== WHAT'S INCLUDED + SURFACES ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">What's included</h2>
          <ul class="mt-6 space-y-2 text-slate-700">
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Pre-clean site walk to identify hazards (slips, drains, sensitive surfaces)</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>RAMS (Risk Assessment &amp; Method Statement) supplied for larger sites</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Hot-water high-pressure cleaning with rotating surface cleaner for flat areas</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Soft-wash method for signage, render and painted surfaces</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Chewing gum removal where required</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Out-of-hours scheduling at no extra charge for regular contracts</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Public liability insurance on every visit</span></li>
          </ul>
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Surfaces we clean</h2>
          <ul class="mt-6 space-y-2 text-slate-700">
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Shopfronts, signage, awnings and entrance steps</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Office building exteriors, render and cladding</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Car parks and customer car parks</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Pavements, walkways and pedestrian areas</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Fuel station forecourts and canopies</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Hotel and restaurant exteriors, smoking areas and outdoor dining</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Warehouse and unit exteriors</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>School playgrounds, MUGAs and outdoor surfaces</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Industrial yards and concrete pads</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== PRICING ===== -->
    <section class="bg-slate-50 py-12 md:py-16 border-y border-slate-200">
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Commercial Power Washing prices in Kilkenny</h2>
        <p class="mt-3 text-slate-600 leading-relaxed max-w-3xl">Commercial work is quoted per site rather than per square metre because access, timing and scope vary so widely. We&rsquo;ll come to site, walk it with you and give a clear written quote — no obligation. Typical ranges to give you a feel:</p>
        <ul class="mt-6 grid gap-2 text-slate-700 max-w-3xl">
          <li class="flex gap-2"><span class="text-accent">€</span><span>Shopfront + entrance area: €150–€350 per visit</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Small customer car park / forecourt: €350–€800</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Larger retail park / hotel exterior: €800–€2,500+</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Regular maintenance contracts: discounted rates</span></li>
        </ul>
        <p class="mt-4 text-sm text-slate-500 max-w-3xl">
          Final quote depends on site, condition and access. Free, no-obligation quote within 24 hours.
        </p>
      </div>
    </section>

    <!-- ===== PROCESS / DETAILS ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2">
      <div>
        <h3 class="text-xl font-semibold text-slate-900">Regular maintenance contracts</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">Many of our commercial clients across Kilkenny take a regular monthly or quarterly maintenance clean — much cheaper than a deep clean every couple of years, and the premises stay consistently presentable. We&rsquo;ll work with you to agree a schedule, scope and fixed price.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">Out-of-hours and weekend scheduling</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">Most commercial cleans for retail, hospitality and fuel forecourts are scheduled outside trading hours so we don&rsquo;t get in the way of customers or staff. Evening, early-morning and weekend work is built into our schedule.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">Insurance and compliance</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">Public liability cover is in place on every visit. RAMS supplied for larger or higher-risk sites. We can be added to a supplier portal or PO system and we issue full VAT invoices.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">Areas we cover</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">Commercial customers across all of County Kilkenny — Kilkenny City, Loughboy, Ferrybank, Callan, Thomastown, Castlecomer, Graiguenamanagh, Bennettsbridge, Freshford, Gowran, Mooncoin, Piltown, Urlingford and the wider county.</p>
      </div>
      </div>
    </section>

    <!-- ===== FAQs ===== -->
    <section class="bg-slate-50 py-12 md:py-16 border-y border-slate-200">
      <div class="mx-auto max-w-3xl px-4">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Frequently asked questions</h2>
        <div class="mt-6 space-y-3">
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Do you work outside business hours?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes. Most retail, hospitality and fuel-forecourt cleans are scheduled outside trading hours — evenings, early mornings or weekends — so we don&rsquo;t disrupt customers or staff.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Can you provide insurance documentation?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes. We can send a copy of our public liability cover before any work starts, and full RAMS for larger or higher-risk sites.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Do you remove chewing gum?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes, specialist gum removal is available as an add-on to any pavement, shopfront or entrance clean.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Can we set up a regular monthly clean?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes — and you&rsquo;ll get a better rate than ad-hoc visits. We&rsquo;ll agree the scope, schedule and fixed price up front.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Do you VAT-invoice?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes — full VAT invoices are issued where required. Happy to be added to a supplier portal or PO system.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- ===== CTA + RELATED ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2 md:items-start">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Ready for a clean finish?</h2>
          <p class="mt-3 text-slate-600 leading-relaxed">
            Get a free, no-obligation quote — usually within 24 hours.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="#quote-form" class="btn-accent">Request a Quote</a>
            <a href={`tel:${SITE.phoneTel}`} class="btn-outline">{SITE.phone}</a>
          </div>
        </div>

        <div>
          <h3 class="text-lg font-semibold text-slate-900">Other services we offer</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/farmyard-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Farmyard & Agri Cleaning</a></li>
            <li><a href="/soft-washing-kilkenny" class="text-primary hover:text-primary-dark">Soft Washing</a></li>
            <li><a href="/gutter-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Gutter Cleaning</a></li>
            <li><a href="/render-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Render Cleaning</a></li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
