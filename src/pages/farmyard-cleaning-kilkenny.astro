---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE } from '../data/site';

const title = "Farmyard Cleaning Kilkenny | Sheds, Parlours, Slatted Units";
const description = "Farmyard, shed and milking parlour cleaning across Kilkenny. Slurry, dung & moss removed. TB-test ready cleans. Free quote within 24 hours.";
const canonical = "https://kilkennypowerwashing.ie/farmyard-cleaning-kilkenny";

const serviceSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Farmyard & Agricultural Cleaning",
    "serviceType": "Farmyard & Agricultural Cleaning",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Kilkenny Power Washing",
      "url": "https://kilkennypowerwashing.ie",
      "telephone": "+353874041811",
      "areaServed": "County Kilkenny, Ireland"
    },
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "County Kilkenny, Ireland"
    },
    "description": "Farmyard, shed and milking parlour cleaning across Kilkenny. Slurry, dung & moss removed. TB-test ready cleans. Free quote within 24 hours.",
    "url": "https://kilkennypowerwashing.ie/farmyard-cleaning-kilkenny"
  };

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Do you do TB-test cleans?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. We do regular pre-TB cleans across the county and can supply a list of products used at correct working concentration for your records."
        }
      },
      {
        "@type": "Question",
        "name": "Can you clean while the stock is in?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Some cleaning can be done with stock on site — most shed cleans really need the stock moved out first for a proper job. We&rsquo;ll advise on what&rsquo;s possible at the site visit."
        }
      },
      {
        "@type": "Question",
        "name": "Do you use approved disinfectants?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes — DAFM-approved disinfectants at the correct working concentration. Happy to show you the product and dilution before we start."
        }
      },
      {
        "@type": "Question",
        "name": "Do you have your own water supply?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We can work off the farm&rsquo;s mains supply or, where access is limited, bring water bowsers on larger jobs. We&rsquo;ll cover this at the site visit."
        }
      },
      {
        "@type": "Question",
        "name": "Can you VAT-invoice for the farm?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes — full VAT invoices issued, with line-item descriptions suitable for your farm accounts."
        }
      }
    ]
  };
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={[serviceSchema, faqSchema]}
>
  <Header />

  <main>
    <!-- ===== HERO ===== -->
    <section class="bg-gradient-to-b from-primary/5 to-white">
      <div class="mx-auto max-w-6xl px-4 py-12 md:py-16 grid gap-10 lg:grid-cols-2 lg:items-start">
        <div>
          <nav class="text-xs text-slate-500 mb-3" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary">Home</a>
            <span class="mx-1">/</span>
            <span class="text-slate-700">Farmyard & Agricultural Cleaning</span>
          </nav>

          <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 leading-tight">
            Farmyard & Agricultural Cleaning in Kilkenny
          </h1>
          <p class="mt-4 text-lg text-slate-600">
            We work with farms across Kilkenny to deep-clean yards, sheds, slatted units, milking parlours and machinery.
          </p>
          <p class="mt-4 text-lg text-slate-600">
            Whether you&rsquo;re getting the place ready for a TB test, prepping a shed before stock comes back in, or just want the yard looking right before the winter, we&rsquo;ll quote a clear, fixed price for the work. Heavy-duty hot-water equipment, approved disinfectants where required and a no-nonsense approach to getting it done.
          </p>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="#quote-form" class="btn-accent">Get a Free Quote</a>
            <a href={`tel:${SITE.phoneTel}`} class="btn-outline">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.77h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.77-.77a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.5 17z"/></svg>
              Call {SITE.phone}
            </a>
            <a
              href={SITE.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:opacity-90"
              style="background-color: #25D366;"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              WhatsApp
            </a>
          </div>

          <ul class="mt-6 text-sm text-slate-600 space-y-1.5">
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Fully insured local team</span></li>
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Free no-obligation quotes</span></li>
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Serving all of County Kilkenny</span></li>
          </ul>
        </div>

        <div class="lg:pl-4">
          <QuoteForm preselectService="Farmyard & Agri Cleaning" />
        </div>
      </div>
    </section>

    <!-- ===== WHAT'S INCLUDED + SURFACES ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">What's included</h2>
          <ul class="mt-6 space-y-2 text-slate-700">
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Hot-water high-pressure cleaning where appropriate</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Approved disinfectant application where required (TB-test prep, between batches)</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Roof and gable soft-washing for sheds and stores</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Yard concrete deep-clean and weed removal</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Tidy-up and rinse-down after</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Fully insured — public liability cover on every job</span></li>
          </ul>
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Surfaces we clean</h2>
          <ul class="mt-6 space-y-2 text-slate-700">
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Concrete yards and feeding areas</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Slatted sheds and cubicle houses</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Milking parlours and bulk-tank rooms</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Calf sheds and weanling pens</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Sheep handling areas, race and pens</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Grain stores, machinery sheds and workshops</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Hen houses and poultry units</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Tractor and machinery washing</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Roofs and gables (soft-wash method)</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== PRICING ===== -->
    <section class="bg-slate-50 py-12 md:py-16 border-y border-slate-200">
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Farmyard & Agricultural Cleaning prices in Kilkenny</h2>
        <p class="mt-3 text-slate-600 leading-relaxed max-w-3xl">Agri jobs vary so much in size and scope that everything is quoted per job. As a rough guide:</p>
        <ul class="mt-6 grid gap-2 text-slate-700 max-w-3xl">
          <li class="flex gap-2"><span class="text-accent">€</span><span>Small yard / single shed: €250–€450</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Multi-shed dairy or beef yard: €500–€1,500</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Full pre-TB clean and disinfect: €600–€2,000</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Larger contracts and regular cleans: discounted rates</span></li>
        </ul>
        <p class="mt-4 text-sm text-slate-500 max-w-3xl">
          Final quote depends on site, condition and access. Free, no-obligation quote within 24 hours.
        </p>
      </div>
    </section>

    <!-- ===== PROCESS / DETAILS ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2">
      <div>
        <h3 class="text-xl font-semibold text-slate-900">TB test and herd-health cleaning</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">We&rsquo;re set up to deliver the deep clean and disinfection routinely needed before a TB test or between batches of stock. We use approved disinfectants at the correct working concentration and can supply documentation of products used where you need it for compliance.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">Roof, shed and gable cleaning</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">Where you want shed roofs, gables or store walls cleaned, we use a soft-wash method to lift moss, algae and lichen without damaging the cladding. Particularly useful before a shed inspection or a re-roof.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">Water supply and access</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">We can work off the farm&rsquo;s mains supply or, where access is limited, bring water bowsers on larger jobs. We&rsquo;ll cover the practicalities at the site visit.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">Areas we cover</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">Farms across all of County Kilkenny — including farms around Callan, Thomastown, Castlecomer, Freshford, Graiguenamanagh, Gowran, Bennettsbridge, Urlingford and the surrounding parishes.</p>
      </div>
      </div>
    </section>

    <!-- ===== FAQs ===== -->
    <section class="bg-slate-50 py-12 md:py-16 border-y border-slate-200">
      <div class="mx-auto max-w-3xl px-4">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Frequently asked questions</h2>
        <div class="mt-6 space-y-3">
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Do you do TB-test cleans?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes. We do regular pre-TB cleans across the county and can supply a list of products used at correct working concentration for your records.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Can you clean while the stock is in?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Some cleaning can be done with stock on site — most shed cleans really need the stock moved out first for a proper job. We&rsquo;ll advise on what&rsquo;s possible at the site visit.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Do you use approved disinfectants?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes — DAFM-approved disinfectants at the correct working concentration. Happy to show you the product and dilution before we start.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Do you have your own water supply?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">We can work off the farm&rsquo;s mains supply or, where access is limited, bring water bowsers on larger jobs. We&rsquo;ll cover this at the site visit.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Can you VAT-invoice for the farm?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes — full VAT invoices issued, with line-item descriptions suitable for your farm accounts.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- ===== CTA + RELATED ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2 md:items-start">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Ready for a clean finish?</h2>
          <p class="mt-3 text-slate-600 leading-relaxed">
            Get a free, no-obligation quote — usually within 24 hours.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="#quote-form" class="btn-accent">Request a Quote</a>
            <a href={`tel:${SITE.phoneTel}`} class="btn-outline">{SITE.phone}</a>
          </div>
        </div>

        <div>
          <h3 class="text-lg font-semibold text-slate-900">Other services we offer</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/commercial-power-washing-kilkenny" class="text-primary hover:text-primary-dark">Commercial Power Washing</a></li>
            <li><a href="/soft-washing-kilkenny" class="text-primary hover:text-primary-dark">Soft Washing</a></li>
            <li><a href="/gutter-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Gutter Cleaning</a></li>
            <li><a href="/roof-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Roof Cleaning</a></li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
