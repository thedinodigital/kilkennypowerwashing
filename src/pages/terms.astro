---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const updated = new Date().toLocaleDateString('en-IE', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  title="Terms of Use | Kilkenny Power Washing"
  description="Terms of use for kilkennypowerwashing.ie — please read before using this site."
  canonical="https://kilkennypowerwashing.ie/terms"
>
  <Header />
  <main>
    <article class="mx-auto max-w-3xl px-4 py-12">
      <h1 class="text-3xl font-bold text-slate-900 md:text-4xl">Terms of Use</h1>
      <p class="mt-2 text-sm text-slate-500">Last updated: {updated}</p>

      <div class="mt-8 space-y-8 text-sm leading-relaxed text-slate-700">
        <section>
          <h2 class="text-lg font-semibold text-slate-900 mb-2">1. About this site</h2>
          <p>
            Kilkennypowerwashing.ie is a lead-generation website that connects homeowners and businesses in County
            Kilkenny with a vetted local power washing contractor. By using this site you agree to these terms.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-slate-900 mb-2">2. Use of the site</h2>
          <p>You may use this site for lawful purposes only. You must not:</p>
          <ul class="list-disc pl-5 mt-2 space-y-1">
            <li>Submit false or misleading information via the quote form.</li>
            <li>Attempt to access systems or data you are not authorised to access.</li>
            <li>Use the site in any way that could damage, disable or impair it.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-slate-900 mb-2">3. Our role</h2>
          <p>
            We are a lead-generation intermediary, not the service provider. When you submit a quote request, your
            details are forwarded to a vetted local contractor. We make no warranty as to the quality, timing or
            outcome of any work carried out by the contractor.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-slate-900 mb-2">4. Pricing information</h2>
          <p>
            Price ranges displayed on this site are indicative only. Actual prices are provided by the contractor
            following a site visit and are subject to change based on the scope of work.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-slate-900 mb-2">5. Intellectual property</h2>
          <p>
            All content on this site, including text, images and code, is owned by or licensed to the site operator.
            You may not reproduce or redistribute any content without permission.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-slate-900 mb-2">6. Limitation of liability</h2>
          <p>
            To the fullest extent permitted by law, we exclude all liability for loss or damage arising from use of
            this site or reliance on any information contained herein.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-slate-900 mb-2">7. Governing law</h2>
          <p>
            These terms are governed by the laws of Ireland. Any disputes shall be subject to the exclusive
            jurisdiction of the Irish courts.
          </p>
        </section>

        <section>
          <h2 class="text-lg font-semibold text-slate-900 mb-2">8. Contact</h2>
          <p>
            Questions about these terms? Email{' '}
            <a href="mailto:kilkennypowerwash@gmail.com" class="text-primary underline">kilkennypowerwash@gmail.com</a>.
          </p>
        </section>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
