---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE } from '../data/site';

const title = "Driveway Cleaning Kilkenny | From €120 | Free Quote";
const description = "Driveway power washing in Kilkenny from €120. Tarmac, concrete, cobblelock & block paving. Joint re-sanding included. Free quote within 24 hours.";
const canonical = "https://kilkennypowerwashing.ie/driveway-cleaning-kilkenny";

const serviceSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Driveway Cleaning",
    "serviceType": "Driveway Cleaning",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Kilkenny Power Washing",
      "url": "https://kilkennypowerwashing.ie",
      "telephone": "+353874041811",
      "areaServed": "County Kilkenny, Ireland"
    },
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "County Kilkenny, Ireland"
    },
    "description": "Driveway power washing in Kilkenny from €120. Tarmac, concrete, cobblelock & block paving. Joint re-sanding included. Free quote within 24 hours.",
    "url": "https://kilkennypowerwashing.ie/driveway-cleaning-kilkenny",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "price": "120",
      "url": "https://kilkennypowerwashing.ie/driveway-cleaning-kilkenny"
    }
  };

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Will pressure washing damage my driveway?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Not when it&rsquo;s done properly. The right nozzle, pressure and surface cleaner makes all the difference. We never blast block paving joints with a turbo nozzle — that&rsquo;s how you lose the sand and end up with a worse-looking driveway. The kiln-dried sand we put back replaces what&rsquo;s lost during cleaning."
        }
      },
      {
        "@type": "Question",
        "name": "Do you re-sand block paving?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes — kiln-dried sand is included as standard on all block paving and cobblelock driveways. We brush it into the joints once the surface has dried, then compact it."
        }
      },
      {
        "@type": "Question",
        "name": "What about oil stains?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Most recent oil stains lift with a pre-treatment. Older, soaked-in stains may not fully clear — we&rsquo;ll be straight with you about what to expect before you commit, and show you the test patch result first."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need to be home?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No, you don&rsquo;t. We just need access to the driveway and an outdoor tap. Most customers leave us to it."
        }
      },
      {
        "@type": "Question",
        "name": "Do you have insurance?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Public liability cover is in place for every job. Happy to send a copy of the cert before we start."
        }
      },
      {
        "@type": "Question",
        "name": "Can I drive on it the same day?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, once the surface has dried and the joint sand has been brushed in and compacted — usually a couple of hours after we finish."
        }
      }
    ]
  };
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={[serviceSchema, faqSchema]}
>
  <Header />

  <main>
    <!-- ===== HERO ===== -->
    <section class="bg-gradient-to-b from-primary/5 to-white">
      <div class="mx-auto max-w-6xl px-4 py-12 md:py-16 grid gap-10 lg:grid-cols-2 lg:items-start">
        <div>
          <nav class="text-xs text-slate-500 mb-3" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary">Home</a>
            <span class="mx-1">/</span>
            <span class="text-slate-700">Driveway Cleaning</span>
          </nav>

          <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 leading-tight">
            Driveway Cleaning in Kilkenny
          </h1>
          <p class="mt-4 text-lg text-slate-600">
            Your driveway is the first thing people see when they pull up to your home — and in Kilkenny's damp climate, it doesn't take long for moss, algae, weeds and ground-in dirt to take over.
          </p>
          <p class="mt-4 text-lg text-slate-600">
            We bring driveways across County Kilkenny back to life with a professional, fully-insured power wash and a proper finish on the joints. Most jobs are done in a day, prices start at €120, and free quotes come back within 24 hours.
          </p>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="#quote-form" class="btn-accent">Get a Free Quote</a>
            <a href={`tel:${SITE.phoneTel}`} class="btn-outline">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.77h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.77-.77a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.5 17z"/></svg>
              Call {SITE.phone}
            </a>
            <a
              href={SITE.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:opacity-90"
              style="background-color: #25D366;"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              WhatsApp
            </a>
          </div>

          <ul class="mt-6 text-sm text-slate-600 space-y-1.5">
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Fully insured local team</span></li>
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Free no-obligation quotes</span></li>
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Serving all of County Kilkenny</span></li>
          </ul>
        </div>

        <div class="lg:pl-4">
          <QuoteForm preselectService="Driveway Cleaning" />
        </div>
      </div>
    </section>

    <!-- ===== WHAT'S INCLUDED + SURFACES ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">What's included</h2>
          <ul class="mt-6 space-y-2 text-slate-700">
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Pre-treatment with a biocide where moss, algae or lichen is heavy</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Hot-water high-pressure wash with a rotating surface cleaner — even finish, no &ldquo;zebra stripes&rdquo;</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Weeds removed from joints</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Kiln-dried sand re-applied to block paving and cobblelock joints — included as standard, not extra</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>All debris cleared and the driveway tidied — ready to use the same day</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Fully insured: public liability cover on every job</span></li>
          </ul>
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Surfaces we clean</h2>
          <ul class="mt-6 space-y-2 text-slate-700">
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Tarmac and asphalt drives</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Plain concrete, brushed concrete and imprinted concrete</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Cobblelock and block paving</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Resin-bound and resin-bonded driveways</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Gravel-topped and part-gravel drives (cleaned in place where possible)</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Granite-set, cobbled and natural stone driveways (soft-wash method)</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== PRICING ===== -->
    <section class="bg-slate-50 py-12 md:py-16 border-y border-slate-200">
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Driveway Cleaning prices in Kilkenny</h2>
        <p class="mt-3 text-slate-600 leading-relaxed max-w-3xl">Honest, transparent pricing. The final quote depends on size, surface and condition — but here&rsquo;s what most Kilkenny driveways come in at:</p>
        <ul class="mt-6 grid gap-2 text-slate-700 max-w-3xl">
          <li class="flex gap-2"><span class="text-accent">€</span><span>Small drive (single car, up to 30m²): €120–€170</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Medium drive (40–70m²): €170–€220</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Two-car drive (80–120m²): €220–€280</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Larger sites (200m²+): quoted on site</span></li>
        </ul>
        <p class="mt-4 text-sm text-slate-500 max-w-3xl">
          Final quote depends on site, condition and access. Free, no-obligation quote within 24 hours.
        </p>
      </div>
    </section>

    <!-- ===== PROCESS / DETAILS ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2">
      <div>
        <h3 class="text-xl font-semibold text-slate-900">How long does it take?</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">An average Kilkenny domestic driveway takes 2 to 4 hours including pre-treatment. Resin and cobblelock can take a little longer because of the joint work. Where the weather allows, we start in the morning so the surface has time to dry before the evening.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">How often should you clean it?</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">In Ireland&rsquo;s wet, mild climate every 12 to 18 months is the sweet spot. Leave it longer and the moss roots go deep into the joints, so each subsequent clean takes longer and re-growth happens faster. A discounted yearly maintenance clean keeps it looking sharp.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">Optional driveway sealing</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">Once the driveway is fully cleaned and dry, an optional sealer locks in the result — keeping colours fast, slowing weed and moss re-growth, and making future cleans quicker and cheaper. Sealing is quoted separately so you can decide once you&rsquo;ve seen the finish.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">Areas we cover</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">All of County Kilkenny — Kilkenny City and Loughboy, Callan, Thomastown, Castlecomer, Graiguenamanagh, Bennettsbridge, Freshford, Gowran, Ferrybank, Mooncoin, Piltown, Urlingford and the surrounding villages and townlands.</p>
      </div>
      </div>
    </section>

    <!-- ===== FAQs ===== -->
    <section class="bg-slate-50 py-12 md:py-16 border-y border-slate-200">
      <div class="mx-auto max-w-3xl px-4">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Frequently asked questions</h2>
        <div class="mt-6 space-y-3">
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Will pressure washing damage my driveway?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Not when it&rsquo;s done properly. The right nozzle, pressure and surface cleaner makes all the difference. We never blast block paving joints with a turbo nozzle — that&rsquo;s how you lose the sand and end up with a worse-looking driveway. The kiln-dried sand we put back replaces what&rsquo;s lost during cleaning.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Do you re-sand block paving?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes — kiln-dried sand is included as standard on all block paving and cobblelock driveways. We brush it into the joints once the surface has dried, then compact it.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>What about oil stains?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Most recent oil stains lift with a pre-treatment. Older, soaked-in stains may not fully clear — we&rsquo;ll be straight with you about what to expect before you commit, and show you the test patch result first.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Do I need to be home?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">No, you don&rsquo;t. We just need access to the driveway and an outdoor tap. Most customers leave us to it.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Do you have insurance?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes. Public liability cover is in place for every job. Happy to send a copy of the cert before we start.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Can I drive on it the same day?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Yes, once the surface has dried and the joint sand has been brushed in and compacted — usually a couple of hours after we finish.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- ===== CTA + RELATED ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2 md:items-start">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Ready for a clean finish?</h2>
          <p class="mt-3 text-slate-600 leading-relaxed">
            Get a free, no-obligation quote — usually within 24 hours.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="#quote-form" class="btn-accent">Request a Quote</a>
            <a href={`tel:${SITE.phoneTel}`} class="btn-outline">{SITE.phone}</a>
          </div>
        </div>

        <div>
          <h3 class="text-lg font-semibold text-slate-900">Other services we offer</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/patio-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Patio Cleaning</a></li>
            <li><a href="/roof-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Roof Cleaning</a></li>
            <li><a href="/gutter-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Gutter Cleaning</a></li>
            <li><a href="/soft-washing-kilkenny" class="text-primary hover:text-primary-dark">Soft Washing</a></li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
