---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { SITE } from '../data/site';

const title = "Soft Washing Kilkenny | Render, Roof & Wall Cleaning";
const description = "Soft washing in Kilkenny for roofs, render, pebbledash and painted walls. Low-pressure biocide method, no surface damage. Free quote within 24 hours.";
const canonical = "https://kilkennypowerwashing.ie/soft-washing-kilkenny";

const serviceSchema = {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Soft Washing",
    "serviceType": "Soft Washing",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Kilkenny Power Washing",
      "url": "https://kilkennypowerwashing.ie",
      "telephone": "+353874041811",
      "areaServed": "County Kilkenny, Ireland"
    },
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "County Kilkenny, Ireland"
    },
    "description": "Soft washing in Kilkenny for roofs, render, pebbledash and painted walls. Low-pressure biocide method, no surface damage. Free quote within 24 hours.",
    "url": "https://kilkennypowerwashing.ie/soft-washing-kilkenny",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR",
      "price": "200",
      "url": "https://kilkennypowerwashing.ie/soft-washing-kilkenny"
    }
  };

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is soft washing safe for my plants and lawn?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "We protect planting before we start, rinse any drift off leaves immediately, and use chemicals at the correct working concentration. Lawns and beds are fine — we do this every week."
        }
      },
      {
        "@type": "Question",
        "name": "Does soft washing work in cold or wet weather?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "It works in most conditions, but we won&rsquo;t apply biocide in heavy rain or freezing temperatures — the chemistry doesn&rsquo;t behave properly. We&rsquo;ll book around the weather where needed."
        }
      },
      {
        "@type": "Question",
        "name": "Will the surface look clean the same day?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sometimes — but soft washing isn&rsquo;t designed for instant gratification. The biocide kills the growth and rain washes it away over the following weeks, so the surface keeps getting better for up to two months after we leave."
        }
      },
      {
        "@type": "Question",
        "name": "Is soft washing more expensive than pressure washing?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "On a like-for-like comparison it&rsquo;s similar. The longer-lasting result usually makes it better value over a 3–5 year window."
        }
      },
      {
        "@type": "Question",
        "name": "Will it kill the moss on my roof for good?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Not for good — moss will eventually return — but professional biocide treatment typically gives 3 to 5 years on a roof and 2 to 4 years on render before any noticeable re-growth."
        }
      }
    ]
  };
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={[serviceSchema, faqSchema]}
>
  <Header />

  <main>
    <!-- ===== HERO ===== -->
    <section class="bg-gradient-to-b from-primary/5 to-white">
      <div class="mx-auto max-w-6xl px-4 py-12 md:py-16 grid gap-10 lg:grid-cols-2 lg:items-start">
        <div>
          <nav class="text-xs text-slate-500 mb-3" aria-label="Breadcrumb">
            <a href="/" class="hover:text-primary">Home</a>
            <span class="mx-1">/</span>
            <span class="text-slate-700">Soft Washing</span>
          </nav>

          <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-slate-900 leading-tight">
            Soft Washing in Kilkenny
          </h1>
          <p class="mt-4 text-lg text-slate-600">
            Some surfaces shouldn&rsquo;t be pressure-washed. Roofs, render, pebbledash, painted walls, sandstone and timber all do badly under a high-pressure blast.
          </p>
          <p class="mt-4 text-lg text-slate-600">
            Soft washing is the modern alternative: low-pressure application of a professional biocide that kills algae, moss and lichen at the source, with no risk of surface damage. We use it across Kilkenny on any surface where pressure isn&rsquo;t the right tool for the job. Free quote within 24 hours.
          </p>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="#quote-form" class="btn-accent">Get a Free Quote</a>
            <a href={`tel:${SITE.phoneTel}`} class="btn-outline">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.77h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l.77-.77a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.5 17z"/></svg>
              Call {SITE.phone}
            </a>
            <a
              href={SITE.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-md px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:opacity-90"
              style="background-color: #25D366;"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              WhatsApp
            </a>
          </div>

          <ul class="mt-6 text-sm text-slate-600 space-y-1.5">
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Fully insured local team</span></li>
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Free no-obligation quotes</span></li>
            <li class="flex gap-2"><span class="text-accent">✓</span><span>Serving all of County Kilkenny</span></li>
          </ul>
        </div>

        <div class="lg:pl-4">
          <QuoteForm preselectService="Soft Washing" />
        </div>
      </div>
    </section>

    <!-- ===== WHAT'S INCLUDED + SURFACES ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">What's included</h2>
          <ul class="mt-6 space-y-2 text-slate-700">
          <li class="flex gap-2"><span class="text-accent">✓</span><span>A walk-around survey to identify surfaces, condition and any sensitive planting</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Protection of windows, doors and beds before we start</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Low-pressure spray application of a professional-grade biocide</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Gentle rinse where needed — never high pressure</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Re-spray on tougher spots so the whole surface comes back evenly</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Fully insured: public liability cover on every job</span></li>
          </ul>
        </div>
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Surfaces we clean</h2>
          <ul class="mt-6 space-y-2 text-slate-700">
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Tile and slate roofs (we never high-pressure roofs)</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Pebbledash and dry-dash render</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Painted render and self-coloured silicone render</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Brick and stone walls with delicate pointing</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Sandstone patios and steps</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Timber decking and cladding (with a tailored chemical mix)</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>UPVC fascias, soffits and conservatory roofs</span></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== PRICING ===== -->
    <section class="bg-slate-50 py-12 md:py-16 border-y border-slate-200">
      <div class="mx-auto max-w-6xl px-4">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Soft Washing prices in Kilkenny</h2>
        <p class="mt-3 text-slate-600 leading-relaxed max-w-3xl">Prices depend on the surface, area and access. Some typical ranges:</p>
        <ul class="mt-6 grid gap-2 text-slate-700 max-w-3xl">
          <li class="flex gap-2"><span class="text-accent">€</span><span>Render soft wash, average semi-detached: €300–€500</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Pebbledash gable wall: €200–€400</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Full house exterior soft wash: €450–€800</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Roof soft wash: €350–€900 (see Roof Cleaning page)</span></li>
          <li class="flex gap-2"><span class="text-accent">€</span><span>Larger or commercial jobs: quoted on site</span></li>
        </ul>
        <p class="mt-4 text-sm text-slate-500 max-w-3xl">
          Final quote depends on site, condition and access. Free, no-obligation quote within 24 hours.
        </p>
      </div>
    </section>

    <!-- ===== PROCESS / DETAILS ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2">
      <div>
        <h3 class="text-xl font-semibold text-slate-900">What soft washing actually is</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">Soft washing applies a low-pressure spray of a professional-grade biocide and detergent to the surface. The chemical does the work — killing back the algae, moss, lichen and mould that cause green and black staining. Loose debris is gently rinsed away, and the biocide continues to work in the surface for weeks after we leave.</p>
        <p class="mt-3 text-slate-600 leading-relaxed">The result: no surface damage, no zebra striping, no joint sand blasted out, and re-growth that&rsquo;s far slower than with high-pressure cleaning alone.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">Why it beats high-pressure cleaning on delicate surfaces</h3>

        <ul class="mt-3 space-y-2 text-slate-700">
          <li class="flex gap-2"><span class="text-accent">✓</span><span>No damage to render, paint or roof tiles</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Removes the algae spores at the root — not just the surface staining</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Much slower re-growth (typically 2–5 years on roofs and render)</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>No water ingress into the building fabric</span></li>
          <li class="flex gap-2"><span class="text-accent">✓</span><span>Quieter and cleaner — less mess, less disruption to neighbours</span></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">How long does it take?</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">Most domestic soft-wash jobs are completed in a single day. The chemical continues to work in the surface for several weeks afterwards — so it actually keeps getting cleaner once we&rsquo;ve left. A treatment typically lasts 2 to 5 years depending on aspect, shade and surrounding planting.</p>
      </div>

      <div>
        <h3 class="text-xl font-semibold text-slate-900">Areas we cover</h3>
        <p class="mt-3 text-slate-600 leading-relaxed">All of County Kilkenny — Kilkenny City, Loughboy, Ferrybank, Callan, Thomastown, Castlecomer, Graiguenamanagh, Bennettsbridge, Freshford, Gowran and the surrounding villages and townlands.</p>
      </div>
      </div>
    </section>

    <!-- ===== FAQs ===== -->
    <section class="bg-slate-50 py-12 md:py-16 border-y border-slate-200">
      <div class="mx-auto max-w-3xl px-4">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Frequently asked questions</h2>
        <div class="mt-6 space-y-3">
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Is soft washing safe for my plants and lawn?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">We protect planting before we start, rinse any drift off leaves immediately, and use chemicals at the correct working concentration. Lawns and beds are fine — we do this every week.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Does soft washing work in cold or wet weather?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">It works in most conditions, but we won&rsquo;t apply biocide in heavy rain or freezing temperatures — the chemistry doesn&rsquo;t behave properly. We&rsquo;ll book around the weather where needed.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Will the surface look clean the same day?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Sometimes — but soft washing isn&rsquo;t designed for instant gratification. The biocide kills the growth and rain washes it away over the following weeks, so the surface keeps getting better for up to two months after we leave.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Is soft washing more expensive than pressure washing?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">On a like-for-like comparison it&rsquo;s similar. The longer-lasting result usually makes it better value over a 3–5 year window.</p>
          </details>
          <details class="group rounded-lg border border-slate-200 bg-white p-5">
            <summary class="flex cursor-pointer items-center justify-between text-slate-900 font-medium">
              <span>Will it kill the moss on my roof for good?</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 transition-transform group-open:rotate-180" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">Not for good — moss will eventually return — but professional biocide treatment typically gives 3 to 5 years on a roof and 2 to 4 years on render before any noticeable re-growth.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- ===== CTA + RELATED ===== -->
    <section class="py-12 md:py-16">
      <div class="mx-auto max-w-6xl px-4 grid gap-10 md:grid-cols-2 md:items-start">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-slate-900">Ready for a clean finish?</h2>
          <p class="mt-3 text-slate-600 leading-relaxed">
            Get a free, no-obligation quote — usually within 24 hours.
          </p>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href="#quote-form" class="btn-accent">Request a Quote</a>
            <a href={`tel:${SITE.phoneTel}`} class="btn-outline">{SITE.phone}</a>
          </div>
        </div>

        <div>
          <h3 class="text-lg font-semibold text-slate-900">Other services we offer</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/roof-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Roof Cleaning</a></li>
            <li><a href="/render-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Render Cleaning</a></li>
            <li><a href="/patio-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Patio Cleaning</a></li>
            <li><a href="/decking-cleaning-kilkenny" class="text-primary hover:text-primary-dark">Decking Restoration</a></li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
